#!/sbin/openrc-run

# HACK: manually use dbus's hardcoded address
DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export DBUS_SESSION_BUS_ADDRESS

description="GNOME Session"
output_logger="logger"
error_logger="logger"

_gs_wl_session="${RC_SVCNAME#*.}"

depend() {
	need dbus
	need "gnome-session-dbus.${_gs_wl_session}"
	if [ "${_gs_wl_session}" = "gnome-login" ]; then
		need gnome-shell.gnome-login
	else
		need gnome-shell
	fi
	need gnome-settings-daemon
	need gnome-session-monitor
	need gnome-session-init
}
